{
  "kind": "OpenCostDatasource",
  "spec": {
    "proxy": {
      "kind": "HTTPProxy",
      "spec": {
        "url": "http://opencost:9003",
        "secret": "opencost-token",
        "allowedEndpoints": [
          { "endpointPattern": "/allocation/compute", "method": "GET" }
        ]
      }
    }
  }
}
