{
  "kind": "Dashboard",
  "metadata": {
    "name": "daily-cost-trend",
    "project": "demo"
  },
  "spec": {
    "display": {
      "name": "Daily cost trend"
    },
    "duration": "7d",
    "refreshInterval": "0s",
    "variables": [
      {
        "kind": "ListVariable",
        "spec": {
          "name": "team",
          "display": {
            "name": "Team"
          },
          "allowMultiple": true,
          "allowAllValue": true,
          "defaultValue": "$__all",
          "plugin": {
            "kind": "OpenCostAggregateVariable",
            "spec": {
              "aggregate": "label:team"
            }
          }
        }
      }
    ],
    "panels": {
      "daily": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Daily cost per team",
            "description": "One point per calendar day in Europe/Copenhagen, idle cost as its own series."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom",
                "mode": "table",
                "values": [
                  "sum",
                  "mean"
                ]
              },
              "yAxis": {
                "format": {
                  "unit": "usd",
                  "decimalPlaces": 2
                }
              },
              "visual": {
                "display": "bar",
                "stack": "all"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "OpenCostAllocationQuery",
                  "spec": {
                    "aggregate": [
                      "label:team"
                    ],
                    "idle": "include",
                    "step": "1d",
                    "timeZone": "Europe/Copenhagen",
                    "filter": "label[team]:${team:doublequote}"
                  }
                }
              }
            }
          ]
        }
      },
      "idleShare": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Idle share per day",
            "description": "Share of each day's cost that no workload requested."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "yAxis": {
                "format": {
                  "unit": "percent-decimal",
                  "decimalPlaces": 0
                },
                "min": 0,
                "max": 1
              },
              "visual": {
                "display": "line",
                "lineWidth": 2,
                "pointRadius": 4
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "OpenCostAllocationQuery",
                  "spec": {
                    "aggregate": [
                      "cluster"
                    ],
                    "idle": "include",
                    "idleOnly": true,
                    "fractionOfTotal": true,
                    "step": "1d",
                    "timeZone": "Europe/Copenhagen"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 12,
              "content": {
                "$ref": "#/spec/panels/daily"
              }
            },
            {
              "x": 0,
              "y": 12,
              "width": 24,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/idleShare"
              }
            }
          ]
        }
      }
    ]
  }
}
